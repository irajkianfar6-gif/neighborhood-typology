# ─── وابستگی‌ها و خروجی بیلد ───────────────────────────────
node_modules/
build/
dist/
coverage/
__pycache__/
*.pyc

# ─── لاگ‌ها ───────────────────────────────────────────────
*.log
*.err.log

# ─── داده‌های حجیم (قابل بازتولید) ─────────────────────────
# فایل خام OpenStreetMap (~192MB) — با scripts/extract_pbf_layers.py بازتولید می‌شود
iran.pbf
# لایه‌های استخراج‌شده و تایل‌ها (~373MB) — با همان اسکریپت + build_vtiles.py بازتولید می‌شوند
public/data/
# خروجی بیلد فرانت‌اند
dist/

# ─── داده‌های Runtime سرور (کش، ران‌ها، آرتیفکت‌ها) ──────────
server/data/
artifacts/
kombai-files/

# ─── محیط و اسرار ─────────────────────────────────────────
.env*
!.env.example
# فایل محیطی workspace فقط برای پیکربندی عمومی نقش (ARA_ANON_ROLE) استفاده می‌شود
# و عمداً در مخزن ثبت می‌شود؛ کلیدهای محرمانه باید در Settings → Environment بمانند.
!.env.local

# ─── سیستم‌عامل و ابزارها ──────────────────────────────────
.DS_Store
Thumbs.db

# ─── پوشه‌های ابزارهای هوش مصنوعی (لازم نیست در مخزن باشند) ──
.claude/
.freebuff/
.kombai/
.mimocode/
.qodo/

# ─── فایل‌های خروجی یکپارچه‌سازی اسناد (نسخه‌های تکراری با شماره) ──
*(*).md
*(*).txt
