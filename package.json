{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f ara",
    "dev:full": "bun scripts/dev-full.mjs",
    "test:typology": "node --test --test-concurrency=1 --import tsx server/*.test.ts server/typology/*.test.ts src/components/typology/*.test.tsx",
    "test:kernel": "node --test --import tsx server/kernelRouter.test.ts",
    "test:shadow": "node --test --import tsx server/kernelShadowMode.test.ts",
    "kernel:test": "python kernel/service/test_kernel_service.py",
    "kernel:serve": "python -X utf8 kernel/service/kernel_service.py",
    "test:external-data": "node --test --import tsx server/externalDataProxy.test.ts",
    "test:satellite": "node --test --import tsx server/satelliteStac.test.ts",
    "test:satellite-pipeline": "node --test --import tsx server/satellitePipeline.test.ts",
    "test:satellite-worker": "python scripts/test_satellite_cog_worker.py",
    "test:satellite-validation": "node --test --import tsx server/satelliteValidation.test.ts && python scripts/satellite_validation_matrix.py --report artifacts/satellite-validation-report.json",
    "ci:satellite": "npm run lint && npm run test:satellite && npm run test:satellite-pipeline && npm run test:satellite-worker && npm run test:satellite-validation",
    "typology:catalog": "python scripts/build_typology_catalog.py",
    "sci:server": "tsx server/index.ts",
    "sci:sync": "python scripts/sync_province_map.py && python scripts/sync_census.py && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync_lfs.ps1",
    "test:neighborhood": "node --test --test-concurrency=1 --import tsx server/noFabrication.test.ts server/neighborhood/*.test.ts server/evidence/*.test.ts server/security/*.test.ts server/ingestion/*.test.ts",
    "test:all": "npm run lint && npm run test:typology && npm run test:neighborhood && python kernel/engine/tests/test_formulas.py",
    "neighborhood:layers": "tsx scripts/fetch_city_layers.ts",
    "neighborhood:reference": "tsx scripts/build_reference_distribution.ts"
  },
  "dependencies": {
    "@amcharts/amcharts5": "^5.20.2",
    "@deck.gl/aggregation-layers": "^9.3.10",
    "@deck.gl/core": "^9.3.10",
    "@deck.gl/geo-layers": "^9.3.10",
    "@deck.gl/layers": "^9.3.10",
    "@deck.gl/react": "^9.3.10",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.2",
    "cesium": "^1.144.0",
    "dagre": "^0.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prop-types": "^15.8.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-iran-maps": "^1.2.2",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "vazirmatn": "^33.0.3",
    "vite": "^6.2.3",
    "vite-plugin-cesium": "^1.2.23"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "pg": "^8.23.1",
    "redis": "^6.2.1"
  }
}
