[TEMPLATE]
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Development-only backend target used by the Vite /api proxy.
ARA_API_PROXY_TARGET="http://localhost:4001"

# Optional public API origin for builds where the UI and API are deployed separately.
VITE_API_BASE_URL=""

# ===== سینا — دستیار هوشمند (Anthropic-compatible / tabitoken) =====
# مقادیر واقعی را در .env.local بگذارید (این فایل در مخزن ثبت می‌شود؛ آن‌جا نه).
# پیشوند ARA_ از تداخل با متغیرهای سراسری ANTHROPIC_* جلوگیری می‌کند.
# ARA_ANTHROPIC_API_KEY: کلید API سرویس سازگار با Anthropic Messages.
#   فقط در سمت سرور (پراکسی vite) خوانده می‌شود و وارد باندل فرانت‌اند نمی‌شود.
ARA_ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
# ARA_ANTHROPIC_BASE_URL: پایه‌ی آدرس API (بدون "/v1/messages").
ARA_ANTHROPIC_BASE_URL="https://tabitoken.com"
# VITE_ANTHROPIC_MODEL: نام مدل مورد استفاده.
VITE_ANTHROPIC_MODEL="claude-opus-5-thinking"

# ===== ARA-NB-2.0 — تحلیل فقط با نام محله =====
# امنیت: توکن‌ها به شکل token:role (role ∈ viewer|analyst|operator|admin)، توکن ≥ ۱۶ نویسه
ARA_API_TOKENS=""
# نقش کاربر بدون توکن همیشه «analyst» (تحلیلگر) است و قابل تغییر نیست؛ برای نقش بالاتر توکن بدهید
# مبداهای مجاز CORS (با کاما). خالی = فقط same-origin
ARA_ALLOWED_ORIGINS=""
ARA_ANTHROPIC_MAX_TOKENS="4096"
# داده‌ها
ARA_PUBLIC_DATA_DIR=""            # پیش‌فرض public/data
ARA_SERVER_DATA_DIR=""            # پیش‌فرض server/data (کش OSM، اجراها، قراردادها، پیمایش)
ARA_GAZETTEER_DIRS=""             # پوشه‌های GeoJSON محلات اضافه (با : جدا)
ARA_REFERENCE_DIR=""              # پیش‌فرض data/reference
# رسترها (GeoTIFF/COG) برای آمار ناحیه‌ای در kernel
WORLDPOP_COG_PATH=""              # مثل /data/rasters/irn_pop_2025_CN_100m_R2025A_v1.tif
NDVI_COG_PATH=""
JRC_FLOOD_COG_PATH=""
GHSL_COG_PATH=""
WORLDCOVER_COG_PATH=""
DEM_COG_PATH=""
SLOPE_COG_PATH=""
# اگر مسیرهای بالا خالی باشند، رسترهای ساخته‌شده با `npm run neighborhood:open-data -- <city>` خوانده می‌شوند
ARA_OPEN_RASTER_DIR=""            # پیش‌فرض server/data/open-rasters
ARA_FAULTS_GEOJSON_PATH=""        # نقشهٔ گسل رسمی (GeoJSON خطی) به‌جای GEM
ARA_FAULT_BUFFER_M="500"          # حریم گسل برای N4 (متر)
ARA_STEEP_SLOPE_PCT="20"          # آستانهٔ شیب تند برای N4 (٪)
ARA_JOB_WALK_MIN="20"             # افق پیاده‌روی R2 (دقیقه)
# مسیریابی پیاده (اختیاری؛ بدون آن فاصلهٔ اقلیدسی × ۱٫۳ با کسر کیفیت روش)
VALHALLA_URL=""
# آینه‌های Overpass (با کاما)
OVERPASS_ENDPOINTS="https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter"
# زمان‌بند تازه‌سازی لایه‌ها/کارت‌ها
ARA_SCHEDULER_ENABLED="1"
# ذخیره‌سازی: json (پیش‌فرض) یا postgres (نیازمند DATABASE_URL و بستهٔ اختیاری pg)
ARA_STORAGE="json"
DATABASE_URL=""
# حریم خصوصی و پیمایش
ARA_PRIVACY_MIN_CELL="10"
ARA_SURVEY_MIN_SECONDS="90"
